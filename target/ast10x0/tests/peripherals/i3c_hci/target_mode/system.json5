// AST10x0 Kernel I2C Test Configuration
// Uses the same memory layout as the kernel-only tests.
{
    arch: {
        type: "armv7m",
        vector_table_start_address: 0x00000000,
        vector_table_size_bytes: 2048,  // 0x800 ( 512vectors)
    },
    kernel: {
        flash_start_address: 0x00000800,  // After vector table
        flash_size_bytes: 262144,         // 256KB for kernel code (in RAM)
        ram_start_address: 0x00040800,    // RAM starts after code
        ram_size_bytes: 391168,           // ends at RAM_NC boundary (0x000A0000)
    },
}
